        },
        {
          "name": "Prescriptions — Detalle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().data;",
                  "pm.test('Has all fields', () => {",
                  "  pm.expect(p.id).to.be.a('number');",
                  "  pm.expect(p.code).to.be.a('string');",
                  "  pm.expect(p.status).to.be.oneOf(['pending', 'consumed']);",
                  "  pm.expect(p.doctor).to.be.an('object');",
                  "  pm.expect(p.patient).to.be.an('object');",
                  "  pm.expect(p.items).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/prescriptions/{{rx_id}}",
              "host": ["{{base_url}}"],
              "path": ["prescriptions", "{{rx_id}}"]
            }
          }
        },
        {
          "name": "Prescriptions — Detalle que no es mio (404)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
