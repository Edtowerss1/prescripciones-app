{
  "info": {
    "name": "Prescriptions API — Full",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección completa de todos los endpoints de la Prescriptions API. Incluye flujos felices, edge cases y errores para los 3 roles (admin, doctor, patient). Requiere migrate:fresh --seed antes de ejecutar."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "admin_token", "value": "" },
    { "key": "doctor_token", "value": "" },
    { "key": "patient_token", "value": "" }
  ],
  "item": [
    {
      "name": "00-Setup Login",
      "description": "Ejecutá estos 3 requests primero para obtener los tokens de cada rol. Los tokens se guardan automáticamente en las variables de colección.",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Has access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "pm.test('Role is admin', () => pm.expect(json.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('admin_token', json.access_token);",
                  "console.log('Admin token saved');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"admin123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Role is doctor', () => pm.expect(json.user.role).to.eql('doctor'));",
                  "pm.collectionVariables.set('doctor_token', json.access_token);",
                  "console.log('Doctor token saved');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"dr@test.com\",\n  \"password\": \"dr123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Role is patient', () => pm.expect(json.user.role).to.eql('patient'));",
                  "pm.collectionVariables.set('patient_token', json.access_token);",
                  "console.log('Patient token saved');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient@test.com\",\n  \"password\": \"patient123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "01-Auth",
      "description": "Perfil, logout y casos de error de autenticación.",
      "item": [
        {
          "name": "Profile (doctor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has id, name, email, role', () => {",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.expect(json.name).to.be.a('string');",
                  "  pm.expect(json.email).to.be.a('string');",
                  "  pm.expect(json.role).to.eql('doctor');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "url": { "raw": "{{base_url}}/auth/profile", "host": ["{{base_url}}"], "path": ["auth", "profile"] }
          }
        },
        {
          "name": "Profile (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": { "raw": "{{base_url}}/auth/profile", "host": ["{{base_url}}"], "path": ["auth", "profile"] }
          }
        },
        {
          "name": "Profile — Sin token (401)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/profile", "host": ["{{base_url}}"], "path": ["auth", "profile"] }
          }
        },
        {
          "name": "Login — Credenciales incorrectas (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "const json = pm.response.json();",
                  "pm.test('Error envelope', () => {",
                  "  pm.expect(json.message).to.be.a('string');",
                  "  pm.expect(json.code).to.eql('UNAUTHORIZED');",
                  "  pm.expect(json.details).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"noexiste@test.com\",\n  \"password\": \"cualquiera\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login — Campos vacíos (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "const json = pm.response.json();",
                  "pm.test('Code VALIDATION_ERROR', () => pm.expect(json.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Logout (doctor)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] }
            }
