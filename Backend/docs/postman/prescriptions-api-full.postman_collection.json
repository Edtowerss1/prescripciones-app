        {
          "name": "Metrics — Dashboard completo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('Totals present', () => {",
                  "  pm.expect(d.totals).to.have.property('doctors');",
                  "  pm.expect(d.totals).to.have.property('patients');",
                  "  pm.expect(d.totals).to.have.property('prescriptions');",
                  "});",
                  "pm.test('By status present', () => {",
                  "  pm.expect(d.by_status).to.have.property('pending');",
                  "  pm.expect(d.by_status).to.have.property('consumed');",
                  "});",
                  "pm.test('By day is array', () => pm.expect(d.by_day).to.be.an('array'));",
                  "pm.test('Top doctors is array', () => pm.expect(d.top_doctors).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
