        {
          "name": "Prescriptions — Listar mis recetas con filtros",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data', () => pm.expect(json.data).to.be.an('array'));",
                  "if (json.data.length > 0) {",
                  "  pm.test('Prescription has doctor/patient/items', () => {",
                  "    const p = json.data[0];",
                  "    pm.expect(p.doctor).to.be.an('object');",
                  "    pm.expect(p.patient).to.be.an('object');",
                  "    pm.expect(p.items).to.be.an('array');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/prescriptions?status=pending&from=2026-01-01&to=2026-12-31&order=desc&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["prescriptions"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" },
                { "key": "order", "value": "desc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
