    {
      "name": "03-Doctor",
      "description": "Flujo completo de médico: buscar pacientes, crear prescripción, listar, detalle, PDF. Requiere doctor_token del setup.",
      "item": [
        {
          "name": "Patients — Buscar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/patients?query=Test&limit=10",
              "host": ["{{base_url}}"],
              "path": ["patients"],
              "query": [
                { "key": "query", "value": "Test" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Prescriptions — Crear",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Status is pending', () => pm.expect(json.data.status).to.eql('pending'));",
                  "pm.test('Has items array', () => pm.expect(json.data.items).to.be.an('array').with.lengthOf(2));",
                  "pm.test('Has code (UUID)', () => pm.expect(json.data.code).to.match(/^[0-9a-f-]+$/));",
                  "pm.collectionVariables.set('rx_id', json.data.id);",
                  "console.log('Prescription created: ' + json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": 1,\n  \"notes\": \"Tomar con abundante agua\",\n  \"items\": [\n    {\n      \"name\": \"Amoxicilina 500mg\",\n      \"dosage\": \"1 cada 8 horas\",\n      \"quantity\": 15,\n      \"instructions\": \"Después de comer\"\n    },\n    {\n      \"name\": \"Ibuprofeno 400mg\",\n      \"dosage\": \"1 cada 12 horas\",\n      \"quantity\": 10,\n      \"instructions\": \"Con comida\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/prescriptions", "host": ["{{base_url}}"], "path": ["prescriptions"] }
          }
        },
        {
          "name": "Prescriptions — Sin items (422)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"patient_id\": 1,\n  \"items\": []\n}" },
            "url": { "raw": "{{base_url}}/prescriptions", "host": ["{{base_url}}"], "path": ["prescriptions"] }
          }
        },
        {
          "name": "Prescriptions — Patient inexistente (422)",
          "event": [
