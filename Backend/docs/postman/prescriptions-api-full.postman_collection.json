              "mode": "raw",
              "raw": "{\n  \"patient_id\": 9999,\n  \"items\": [{ \"name\": \"X\", \"quantity\": 1 }]\n}"
            },
            "url": { "raw": "{{base_url}}/prescriptions", "host": ["{{base_url}}"], "path": ["prescriptions"] }
          }
        },
        {
          "name": "Prescriptions — Desde paciente (403)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"] } }
