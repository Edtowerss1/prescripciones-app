          "name": "Prescriptions — Orden inválido (422)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/prescriptions?order=invalid",
              "host": ["{{base_url}}"],
              "path": ["prescriptions"],
              "query": [{ "key": "order", "value": "invalid" }]
            }
